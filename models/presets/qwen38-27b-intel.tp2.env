# qwen38-27b-intel on two cards (XEN_TP=2): this setup's settings over qwen38-27b-intel.env.
# The fastest measured two-card setup: an int8 KV cache (draft trees stay on; int8-v4 drafts chains on the 27B) and
# every int4 matrix of the prompt on the library GEMMs (onednn-all), over the default 262,144-token max context.
XEN_KV=int8
XEN_PREFILL_GEMM=onednn-all
