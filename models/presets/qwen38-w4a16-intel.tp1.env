# qwen38-w4a16-intel on one card (XEN_Q38_TP=1): this setup's settings over qwen38-w4a16-intel.env.
# 4 slots on a 524,288-token int8-v4 KV pool, as many hot experts as fit (the rest are read from host RAM, part of
# them computed by the CPU), the DFlash 2 drafter, prefill chunks of 4,096 tokens with cold experts staged per prompt.
# Lent KV pages give way to older cached conversations first (lru).
XEN_SLOTS=4
XEN_CONTEXT=524288
XEN_KV_POOL_TOKENS=524288
XEN_DRAFTER_MODEL=~/models/qwen38-flash-next-dflash2
XEN_SAMPLE_THREADS=8
XEN_PREFILL_CHUNK=4096
XEN_RESERVE=0.25
XEN_KV=int8-v4
XEN_MOE_CPU=auto
XEN_PREFILL_COLD_STAGE=64
XEN_KV_LEND_PRESSURE=lru
XEN_KV_LEND_GRACE_S=300
