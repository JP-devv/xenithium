# Nanbeige 4.3 33B (arch llama), int4 checkpoint: preset settings, read by scripts/start-server.sh
# (docs/server-env.md, "Per-model settings files"). To change them, save from scripts/launch.sh or copy this file to
# models/nanbeige43-33b.env: your file replaces this preset and is never touched by an update.
# Two cards, 8 slots (llama's most), prefill chunks of 2,048 tokens, the trained context length.
XEN_MODEL=~/models/nanbeige43-33b-int4
XEN_SERVED_NAME=nanbeige43-33b
XEN_SLOTS=8
XEN_CONTEXT=262144
XEN_PREFILL_CHUNK=2048
XEN_TP=2
XEN_SAMPLE_THREADS=8
