# Qwen3.8-27B, the W4A16 AutoRound checkpoint (arch qwen35): preset settings, read by scripts/start-server.sh
# (docs/server-env.md, "Per-model settings files"). To change them, save from scripts/launch.sh or copy this file to
# models/qwen38-27b-intel.env: your file replaces this preset and is never touched by an update.
# 16 slots; the DSpine b16 block drafter with draft trees, 16-token blocks after a good step and prompt lookup;
# an int8 KV cache. Prefill chunks of 2,048 tokens; the max context rides the script default (262,144). The setup file (qwen38-27b-intel.tp<N>.env) adds each card
# count's own settings.
XEN_MODEL=~/models/Qwen3.8-27B-W4A16-AutoRound
XEN_SERVED_NAME=qwen38-27b-intel
XEN_SLOTS=16
XEN_PREFILL_CHUNK=2048
XEN_DRAFTER=1
XEN_DRAFTER_MODEL=~/models/qwen38-27b-dspine-b16
XEN_PREFIX_MARK_MIN=2048
XEN_SAMPLE_THREADS=8
XEN_DRAFTER_TREE=7
XEN_LOOKUP=4
XEN_DRAFTER_WIDE=7
XEN_TP=2
XEN_KV=int8
XEN_PREFILL_WIRE=auto
XEN_PREFILL_ATTN=auto
