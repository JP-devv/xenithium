# qwen38-w4a16-intel on four cards (XEN_Q38_TP=4): this setup's settings over qwen38-w4a16-intel.env.
# 16 slots, a 1,048,576-token max context on an int8-v4 KV cache, the DFlash 2 drafter, prefill chunks of 4,096
# tokens, decode steps of up to 64 rows (the four-card default: 16 rows to 5 streams, 32 to 8, 64 from 9). Every expert
# fits in VRAM, so the CPU expert path is off.
XEN_SLOTS=16
XEN_CONTEXT=1048576
XEN_DRAFTER_MODEL=~/models/qwen38-flash-next-dflash2
XEN_SAMPLE_THREADS=8
XEN_PREFILL_CHUNK=4096
XEN_RESERVE=0.25
XEN_KV=int8-v4
XEN_MOE_CPU=off
