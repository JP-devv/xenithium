# Qwen3.8-27B, the swift15 W4A16 AutoRound checkpoint (arch qwen35): preset settings, read by
# scripts/start-server.sh (docs/server-env.md, "Per-model settings files"). To change them, save from
# scripts/launch.sh or copy this file to models/qwen38-27b.env: your file replaces this preset and is never touched
# by an update.
# Two cards, 16 slots; the DSpine b16 block drafter with draft trees and 16-token blocks after a good step; an
# int8 KV cache; image input off. Prefill chunks of 2,048 tokens; the max context rides the script default
# (262,144 - the trained length: no YaRN).
XEN_MODEL=~/models/swift15-w4a16-autoround
XEN_SERVED_NAME=qwen38-27b-w4a16
XEN_SLOTS=16
XEN_PREFILL_CHUNK=2048
XEN_DRAFTER=1
XEN_DRAFTER_MODEL=~/models/qwen38-27b-dspine-b16
XEN_PREFIX_MARK_MIN=2048
XEN_SAMPLE_THREADS=8
XEN_TP=2
XEN_PREFILL_ATTN=auto
XEN_DRAFTER_CUT=0.02
XEN_VISION=0
XEN_MEDIA_URLS=0
XEN_KV=int8
XEN_DRAFTER_TREE=7
XEN_DRAFTER_WIDE=7
