# Qwen3.8-Flash-Next, the W4A16 AutoRound checkpoint (arch qwen38): preset settings, read by scripts/start-server.sh
# (docs/server-env.md, "Per-model settings files"). To change them, save from scripts/launch.sh or copy this file to
# models/qwen38-w4a16-intel.env: your file replaces this preset and is never touched by an update.
# Each card count (XEN_Q38_TP = 1, 2 or 4) keeps its own settings in qwen38-w4a16-intel.tp<N>.env. This preset starts
# the four-card setup; set XEN_Q38_TP to the number of cards you have.
XEN_MODEL=~/models/qwen38-w4a16-intel
XEN_SERVED_NAME=qwen38-flash-next-w4a16-intel
XEN_Q38_TP=4
XEN_VISION=0
