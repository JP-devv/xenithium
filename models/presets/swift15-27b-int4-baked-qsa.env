# Qwen3.8-27B Swift-1.5 Uncensored, the GPTQ int4 baked checkpoint, with trained K8V4 QSA: the fastest measured setup
# (docs/trained-k8v4-qsa.md, "Recommended configuration"; which kernel each setting picks: docs/kernel-map.md).
# Read by scripts/start-server.sh. Needs the trained selector bank (XEN_TRAINED_QSA_DELTA_DIR, not shipped with the
# checkpoint) and the DSpine b16 drafter. Without the bank: docs/recommended-settings.md, "Without the bank".
# 6 slots on the int8-v4 KV (the most that fit next to the trained summaries and the prefix cache on 24 GB cards);
# DSpine b16 with 16-row segments, trees through 2 streams, chains past that; page-selected prefill (256 pages).
# Only started by name (XEN_MODEL_ENV=swift15-27b-int4-baked-qsa), never picked by the checkpoint lookup: it needs the bank.
XEN_PRESET_EXPLICIT=1
XEN_MODEL=~/models/swift15-27b-int4-baked
XEN_SERVED_NAME=swift15-27b-int4-baked
XEN_TP=2
XEN_SLOTS=6
XEN_KV=int8-v4
XEN_KV_POOL_TOKENS=884416
# 2 GiB per card left free after the pool: drafter pass graphs (up to ~1 GiB) and step buffers at full concurrency
XEN_RESERVE=2.0
XEN_DRAFTER=1
XEN_DRAFTER_MODEL=~/models/qwen38-27b-dspine-b16
XEN_SEG_ROWS=16
XEN_DRAFT_DEPTHS=15,7,4,3
XEN_DRAFTER_TREE=7
XEN_DRAFTER_TREE_WIDE=15
XEN_DRAFTER_WIDE=7
XEN_DRAFTER_TREE_SEQS=2
XEN_DRAFTER_CUT=0.02
XEN_DRAFTER_MTP_FROM=0
XEN_LOOKUP=4
XEN_PREFILL_CHUNK=2048
XEN_PREFILL_SELECT=256
XEN_PREFIX_MARK_MIN=2048
XEN_SAMPLE_THREADS=8
# Trained QSA (read by the server itself)
XEN_TRAINED_QSA_DELTA_DIR=~/models/swift15-27b-trained-qsa-bank
XEN_TRAINED_QSA_TILED_SCORE=1
XEN_TRAINED_QSA_POOL_FP16=1
XEN_TRAINED_QSA_TREE=1
XEN_QSA_XMX_SCORE=1
XEN_QSA_GATHER=1
XEN_QSA_RESIDENT_SNAPSHOTS=1
XEN_QSA_RESIDENT_FORK_COPY=1
XEN_PREFILL_SHARE=0.33
