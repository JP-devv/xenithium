# Recursive Flint (arch flint), int4 checkpoint: preset settings, read by scripts/start-server.sh
# (docs/server-env.md, "Per-model settings files"). To change them, save from scripts/launch.sh or copy this file to
# models/flint-int4.env: your file replaces this preset and is never touched by an update.
# Two cards, 8 slots (flint's most), prefill chunks of 4,096 tokens, step graphs on, the DFlash 2 drafter (flint's only
# drafter).
XEN_MODEL=~/models/flint-int4
XEN_SERVED_NAME=flint-int4
XEN_SLOTS=8
XEN_CONTEXT=1048576
XEN_PREFILL_CHUNK=4096
XEN_TP=2
XEN_GRAPHS=1
XEN_SAMPLE_THREADS=8
XEN_DRAFTER_MODEL=~/models/flint-dflash2
