# qwen38-flash-next on four cards (XEN_Q38_TP=4): this setup's settings over qwen38-flash-next.env.
# 16 slots on a 524,288-token KV pool, the MTP drafter. Prefill chunks of 4,096 tokens; the max context rides
# the default (262,144: the trained length, no YaRN). Every expert fits in VRAM, so
# the CPU expert path is off.
XEN_SLOTS=16
XEN_PREFILL_CHUNK=4096
XEN_KV_POOL_TOKENS=524288
XEN_HOT=
XEN_MTP=~/models/qwen38-w4a16/runtime/mtp-int4-g32
XEN_SAMPLE_THREADS=8
XEN_MOE_CPU=off
