# qwen38-flash-next on one card (XEN_Q38_TP=1): this setup's settings over qwen38-flash-next.env.
# 4 slots on a 524,288-token KV pool, as many hot experts as fit (the rest are read from host RAM, part of them
# computed by the CPU), the MTP drafter, cold experts staged per prompt. Prefill chunks of 4,096 tokens; the max
# context rides the default (262,144: the trained length, no YaRN).
XEN_SLOTS=4
XEN_PREFILL_CHUNK=4096
XEN_KV_POOL_TOKENS=524288
XEN_HOT=
XEN_MTP=~/models/qwen38-w4a16/runtime/mtp-int4-g32
XEN_SAMPLE_THREADS=8
XEN_MOE_CPU=auto
XEN_PREFILL_COLD_STAGE=32
