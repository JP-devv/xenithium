# Qwen3.8-Flash-Next, the W4A16 checkpoint (arch qwen38): preset settings, read by scripts/start-server.sh
# (docs/server-env.md, "Per-model settings files"). To change them, save from scripts/launch.sh or copy this file to
# models/qwen38-flash-next.env: your file replaces this preset and is never touched by an update.
# Each card count (XEN_Q38_TP = 1, 2 or 4; unset = 2) keeps its own settings in qwen38-flash-next.tp<N>.env.
XEN_MODEL=~/models/qwen38-w4a16
XEN_SERVED_NAME=qwen38-flash-next-w4a16
